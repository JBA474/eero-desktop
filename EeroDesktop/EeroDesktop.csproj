<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms is used only for the notification-area (tray) icon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>EeroDesktop</AssemblyName>
    <RootNamespace>EeroDesktop</RootNamespace>
    <Product>eero Desktop</Product>
    <!-- FileDescription: the name Windows shows on notifications and in Task Manager. -->
    <AssemblyTitle>eero Desktop</AssemblyTitle>
    <Version>0.1.0</Version>
    <!-- WPF0001: Application.ThemeMode (Fluent theme) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep WPF types unambiguous (Application, MessageBox, Button…); WinForms is referenced explicitly where used. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
