<local:PageBase x:Class="EeroDesktop.Pages.SettingsPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:EeroDesktop.Pages">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="How eero Desktop looks, starts and notifies you, plus backups and information about the app."
                       Style="{StaticResource PageSubtitle}"/>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Use Windows Setting" Margin="0,0,20,0" Checked="Theme_Checked" Tag="System"/>
                        <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Light" Margin="0,0,20,0" Checked="Theme_Checked" Tag="Light"/>
                        <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Dark" Checked="Theme_Checked" Tag="Dark"/>
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Applies right away. The tray icon's menu picks up the change the next time eero Desktop starts."/>
                </StackPanel>
            </Border>

            <!-- Window & Startup -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Window &amp; Startup" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="StartWithWindows" Content="Start eero Desktop when I sign in to Windows" Click="StartWithWindows_Click"/>
                    <TextBlock x:Name="StartWithWindowsNote" Margin="28,0,0,6" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <CheckBox x:Name="StartInTray" Content="Start in the system tray (open the window from the tray icon)" Checked="Option_Click" Unchecked="Option_Click" Margin="0,4,0,0"/>
                    <CheckBox x:Name="CloseToTray" Content="Keep running in the system tray when the window is closed" Checked="Option_Click" Unchecked="Option_Click" Margin="0,8,0,0"/>

                    <TextBlock Text="Notifications" FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <CheckBox x:Name="OutageAlerts" Content="Alert me when the internet or an eero goes down, and when it comes back" Checked="Option_Click" Unchecked="Option_Click"/>
                    <CheckBox x:Name="NewDeviceAlerts" Content="Alert me when a device joins the network for the first time" Checked="Option_Click" Unchecked="Option_Click" Margin="0,8,0,0"/>
                    <CheckBox x:Name="MonthlySummaryOption" Content="Send me a monthly summary: average speed, outages and DNS benchmarks" Checked="Option_Click" Unchecked="Option_Click" Margin="0,8,0,0"/>
                    <CheckBox x:Name="AppUpdateAlerts" Content="Tell me when a new version of eero Desktop is available (checked daily on GitHub)" Checked="Option_Click" Unchecked="Option_Click" Margin="0,8,0,0"/>
                    <CheckBox x:Name="EeroAppReleaseAlerts" Content="Tell me when eero releases a new version of its app (checked weekly on Google Play)" Checked="Option_Click" Unchecked="Option_Click" Margin="0,8,0,0"/>
                    <TextBlock x:Name="NotificationNote" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Send a Test Notification" Click="TestNotification_Click"/>
                        <Button x:Name="MonthlySummaryButton" Content="Show Last Month's Summary" Click="MonthlySummary_Click"/>
                        <Button Content="View Alert History" Click="AlertHistory_Click"/>
                        <Button Content="Forget Known Devices" Click="ForgetDevices_Click"
                                ToolTip="Re-learn which devices are on the network (no alerts for devices already there)."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Backup & Export -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Backup &amp; Export" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="App Settings" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"
                               Text="Your eero Desktop preferences, the list of known devices and your history (speed tests, outages, DNS benchmarks, devices joining and leaving), in one file you can restore on this or another PC. Restoring adds the backup's history to what's here. Your eero sign-in is never included."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Back Up App Settings…" Click="BackupApp_Click"/>
                        <Button Content="Restore App Settings…" Click="RestoreApp_Click"/>
                    </StackPanel>

                    <TextBlock Text="Network Configuration" FontWeight="SemiBold" Margin="0,16,0,2"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"
                               Text="A snapshot of the selected network as eero reports it — settings, eeros, devices, profiles, IP reservations, port forwards and guest network — for your records or to compare later. It isn't restored automatically, because rewriting a network's settings can restart every eero."/>
                    <CheckBox x:Name="IncludePasswords" Content="Include Wi-Fi passwords in the snapshot" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Export Network Snapshot…" Click="ExportNetwork_Click"/>
                        <Button Content="Export Devices to CSV…" Click="ExportDevices_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionTitle}"/>
                    <DockPanel Margin="0,0,0,10">
                        <Image Source="/Assets/AppIcon.ico" Width="48" Height="48" DockPanel.Dock="Left" Margin="0,0,14,0" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="eero Desktop" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="eero Desktop manages eero mesh Wi-Fi networks from Windows, without a phone. It talks to the same eero cloud service as the eero mobile app, using your eero account."/>
                    <Border BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                            BorderBrush="{DynamicResource SystemFillColorCautionBrush}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                        <TextBlock x:Name="Disclaimer" TextWrapping="Wrap" AutomationProperties.AutomationId="Disclaimer"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <Run FontWeight="SemiBold" Text="Unofficial application."/>
                            <Run Text="eero Desktop is not developed, endorsed or supported by eero LLC or Amazon.com, Inc. It uses eero's cloud service the same way the eero mobile app does, and eero may change that service at any time. eero is a trademark of eero LLC, an Amazon company. Use at your own risk; for official support, use the eero app or contact eero."/>
                        </TextBlock>
                    </Border>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="What it can do:"/>
                    <TextBlock TextWrapping="Wrap" Margin="12,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" LineHeight="20">
                        • See network health, speed tests and every eero and connected device<LineBreak/>
                        • Rename, pause, block and organize devices into profiles with schedules and content filters<LineBreak/>
                        • Change Wi-Fi and guest network names and passwords<LineBreak/>
                        • Block ads, adjust DNS, IPv6, SQM, Thread and other advanced settings, one change at a time<LineBreak/>
                        • Manage IP reservations, port forwarding, eero ports, status lights and software updates<LineBreak/>
                        • Get alerts from the system tray when the internet or an eero goes down or a new device joins<LineBreak/>
                        • Keep a history of speed tests, outages and DNS benchmarks on this PC, with trend charts
                    </TextBlock>
                    <TextBlock Text="eero Desktop Updates" FontWeight="SemiBold" Margin="0,4,0,4"/>
                    <TextBlock x:Name="AppUpdateStatus" TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.AutomationId="AppUpdateStatus"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="AppUpdateCheckButton" Content="Check for Updates" Click="AppUpdateCheck_Click"/>
                        <Button x:Name="AppUpdateInstallButton" Content="Download and Install" Style="{StaticResource PrimaryButton}"
                                Click="AppUpdateInstall_Click" Visibility="Collapsed"/>
                        <Button Content="View Releases on GitHub" Click="AppReleases_Click"/>
                    </StackPanel>
                    <TextBlock Margin="0,0,0,10" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Updates come from the GitHub releases of github.com/JBA474/eero-desktop. Each download is checked against the SHA-256 checksum GitHub publishes for it and is only installed if it matches; eero Desktop then restarts."/>
                    <TextBlock Text="eero App Compatibility" FontWeight="SemiBold" Margin="0,4,0,4"/>
                    <TextBlock x:Name="EeroAppStatus" TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.AutomationId="EeroAppStatus"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="EeroAppCheckButton" Content="Check for a New eero App" Click="EeroAppCheck_Click"/>
                    </StackPanel>
                    <TextBlock Text="Credits" FontWeight="SemiBold" Margin="0,4,0,4"/>
                    <TextBlock x:Name="DnspyreCredit" TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="20">
                        <Run Text="DNS Benchmark is powered by"/>
                        <Hyperlink NavigateUri="https://github.com/Tantalor93/dnspyre" RequestNavigate="Link_RequestNavigate"
                                   AutomationProperties.AutomationId="DnspyreSourceLink">dnspyre</Hyperlink>
                        <Run Text="by Tantalor93 — a command-line DNS benchmark tool, based on dnstrace by Rahul Powar. Used under the MIT License."/>
                        <LineBreak/>
                        <Run Text="Source:"/>
                        <Hyperlink NavigateUri="https://github.com/Tantalor93/dnspyre" RequestNavigate="Link_RequestNavigate">github.com/Tantalor93/dnspyre</Hyperlink>
                        <Run Text="  ·  Documentation:"/>
                        <Hyperlink NavigateUri="https://tantalor93.github.io/dnspyre/" RequestNavigate="Link_RequestNavigate"
                                   AutomationProperties.AutomationId="DnspyreDocsLink">tantalor93.github.io/dnspyre</Hyperlink>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="DnspyreLicenseButton" Content="View dnspyre License" Click="DnspyreLicense_Click"/>
                    </StackPanel>
                    <ItemsControl x:Name="AboutFacts" ItemTemplate="{StaticResource FactTemplate}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open Data Folder" Click="OpenDataFolder_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:PageBase>
