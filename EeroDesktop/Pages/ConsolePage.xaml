<local:PageBase x:Class="EeroDesktop.Pages.ConsolePage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:EeroDesktop.Pages">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="API Console" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Call any eero API endpoint directly — everything the Android app can do that isn't on another page. {network} and {id} are replaced with the selected network's ID. Changes made here take effect immediately."/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Preset" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"/>
            <ComboBox x:Name="PresetCombo" SelectionChanged="Preset_Changed"/>
        </DockPanel>
        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <ComboBox x:Name="MethodCombo" Width="90" SelectedIndex="0">
                <ComboBoxItem Content="GET"/>
                <ComboBoxItem Content="POST"/>
                <ComboBoxItem Content="PUT"/>
                <ComboBoxItem Content="DELETE"/>
            </ComboBox>
            <ComboBox x:Name="BodyKind" Width="90" SelectedIndex="0" Margin="8,0,0,0" DockPanel.Dock="Right">
                <ComboBoxItem Content="JSON"/>
                <ComboBoxItem Content="Form"/>
            </ComboBox>
            <Button Content="Send" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Send_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
            <TextBox x:Name="PathBox" Margin="8,0,0,0" FontFamily="Cascadia Mono, Consolas"/>
        </DockPanel>
        <TextBox x:Name="BodyBox" Grid.Row="3" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                 ToolTip="Request body. JSON for @Body endpoints, or key=value lines for form (@Field) endpoints."/>
        <TextBlock Grid.Row="4" x:Name="ResultLabel" Text="Response" Style="{StaticResource SectionTitle}" Margin="0,12,0,6"/>
        <TextBox x:Name="ResultBox" Grid.Row="5" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
    </Grid>
</local:PageBase>
