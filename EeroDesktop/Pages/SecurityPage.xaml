<local:PageBase x:Class="EeroDesktop.Pages.SecurityPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:EeroDesktop.Pages">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Security Check" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="A read-only review of your network: risky settings, every port open to the internet and where it leads, devices without a proper name, and pending updates. Nothing is changed here — each row says which page fixes it."/>
            <StackPanel Style="{StaticResource Toolbar}">
                <Button Content="Run Check Again" Style="{StaticResource PrimaryButton}" Click="Rerun_Click"/>
                <TextBlock x:Name="Summary" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0"
                           AutomationProperties.AutomationId="SecuritySummary"/>
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="Findings" AutomationProperties.AutomationId="SecurityFindings" AutomationProperties.Name="Security findings"
                  MouseDoubleClick="Findings_DoubleClick" ToolTip="Double-click a row to open the page that fixes it">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Status" CellTemplate="{StaticResource StatusCell}" SortMemberPath="Status" Width="Auto" MinWidth="100"/>
                <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="Auto"/>
                <DataGridTemplateColumn Header="Details" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Where to Fix" Binding="{Binding Where}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</local:PageBase>
