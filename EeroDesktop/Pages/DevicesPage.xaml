<local:PageBase x:Class="EeroDesktop.Pages.DevicesPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:EeroDesktop.Pages">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Devices" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="CountText" Style="{StaticResource PageSubtitle}"/>
            <StackPanel Style="{StaticResource Toolbar}">
                <Button Content="Rename" Click="Rename_Click"/>
                <Button Content="Pause / Resume" Click="Pause_Click"/>
                <Button Content="Block / Unblock" Style="{StaticResource DangerButton}" Click="Block_Click"/>
                <Button Content="Assign Profile" Click="Profile_Click"/>
                <Button Content="Reserve IP" Click="Reserve_Click"/>
                <Button Content="Details" Click="Details_Click"/>
            </StackPanel>
            <StackPanel Style="{StaticResource Toolbar}">
                <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="SearchBox" Width="260" TextChanged="Filter_Changed"/>
                <CheckBox x:Name="OnlineOnly" Content="Online Only" Margin="16,0,0,0" IsChecked="True" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="NeedsNameOnly" Content="Needs a Name" Margin="16,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"
                          ToolTip="Devices eero only knows by a machine-made name (MAC address, network hostname, or a random default). Select one and press Rename for a suggested name."/>
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="Grid" MouseDoubleClick="Details_Click">
            <DataGrid.Columns>
                <!-- Short columns size to their header and content (never cut off); Name, Manufacturer and Connection share
                     the remaining width. Below the minimums the grid scrolls sideways. -->
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.6*" MinWidth="140"/>
                <DataGridTemplateColumn Header="Status" CellTemplate="{StaticResource StatusCell}" SortMemberPath="Status" Width="Auto" MinWidth="84"/>
                <DataGridTextColumn Header="IP Address" Binding="{Binding Ip}" Width="Auto"/>
                <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="Auto"/>
                <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="1*" MinWidth="100"/>
                <DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="1.2*" MinWidth="120"/>
                <DataGridTextColumn Header="Connected To" Binding="{Binding Source}" Width="Auto"/>
                <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="Auto"/>
                <DataGridTextColumn Header="Last Active" Binding="{Binding LastActive}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</local:PageBase>
